TELESEC_ENV=development
TELESEC_API_HOST=127.0.0.1
TELESEC_API_PORT=8000
TELESEC_WEB_PORT=3000
TELESEC_BIND_ADDRESS=127.0.0.1
TELESEC_RUNTIME_DATA_DIR=./services/api/runtime-data
TELESEC_WEB_ORIGIN=http://127.0.0.1:3000
TELESEC_API_PROXY_URL=http://api:8000
NEXT_PUBLIC_TELESEC_API_URL=
NEXT_PUBLIC_TELESEC_AGENT_SERVER_URL=http://127.0.0.1:8000

TELESEC_ENROLLMENT_TTL_SECONDS=900
TELESEC_HEARTBEAT_INTERVAL_SECONDS=30
TELESEC_AGENT_OFFLINE_AFTER_SECONDS=90
TELESEC_COMMAND_TTL_SECONDS=900
TELESEC_MAX_SCAN_TARGETS=10
TELESEC_SCAN_CONCURRENCY=3
TELESEC_ALLOW_PUBLIC_SCOPES=false

TELESEC_DEFAULT_SERVER_URL=http://127.0.0.1:8000

# Windows production release inputs. Keep secrets outside source control.
TELESEC_ISCC_PATH=C:\Program Files (x86)\Inno Setup 6\ISCC.exe
TELESEC_SIGNTOOL_PATH=
TELESEC_SIGN_CERT_SHA1=
