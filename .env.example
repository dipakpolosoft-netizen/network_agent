FORGESEC_ENV=development
FORGESEC_CUSTOMER_ID=
FORGESEC_COMPOSE_PROJECT=forgesec
FORGESEC_ADOPT_LEGACY_CUSTOMER_DATA=false
FORGESEC_API_HOST=127.0.0.1
FORGESEC_API_PORT=8000
FORGESEC_WEB_PORT=3000
FORGESEC_BIND_ADDRESS=127.0.0.1
FORGESEC_RUNTIME_DATA_DIR=./services/api/runtime-data
FORGESEC_DATABASE_URL=
FORGESEC_POSTGRES_PASSWORD=
FORGESEC_AUTH_REQUIRED=true
FORGESEC_SESSION_TTL_SECONDS=43200
FORGESEC_WEB_ORIGIN=http://127.0.0.1:3000
FORGESEC_PUBLIC_HOST=
FORGESEC_INGRESS_BIND_ADDRESS=0.0.0.0
FORGESEC_API_PROXY_URL=http://api:8000
NEXT_PUBLIC_FORGESEC_API_URL=
NEXT_PUBLIC_FORGESEC_AGENT_SERVER_URL=http://127.0.0.1:8000

FORGESEC_ENROLLMENT_TTL_SECONDS=900
FORGESEC_HEARTBEAT_INTERVAL_SECONDS=30
FORGESEC_AGENT_OFFLINE_AFTER_SECONDS=90
FORGESEC_COMMAND_TTL_SECONDS=900
FORGESEC_MAX_SCAN_TARGETS=4096
FORGESEC_SCAN_CONCURRENCY=3
FORGESEC_ALLOW_PUBLIC_SCOPES=false

FORGESEC_DEFAULT_SERVER_URL=http://127.0.0.1:8000

# Windows production release inputs. Keep secrets outside source control.
FORGESEC_ISCC_PATH=C:\Program Files (x86)\Inno Setup 6\ISCC.exe
FORGESEC_SIGNTOOL_PATH=
FORGESEC_SIGN_CERT_SHA1=
