{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.forgesec.local/v1/scan-progress.schema.json",
  "title": "ForgeSec Scan Progress",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_type", "scan_id", "agent_id", "status", "total", "queued", "running", "completed", "failed", "cancelled", "updated_at"],
  "properties": {
    "schema_version": { "$ref": "https://schemas.forgesec.local/v1/common.schema.json#/$defs/schemaVersion" },
    "message_type": { "const": "scan.progress" },
    "scan_id": { "$ref": "https://schemas.forgesec.local/v1/common.schema.json#/$defs/uuid" },
    "agent_id": { "$ref": "https://schemas.forgesec.local/v1/common.schema.json#/$defs/uuid" },
    "status": { "enum": ["queued", "running", "completed", "partial", "failed", "cancelled"] },
    "stage": { "type": ["string", "null"], "maxLength": 128 },
    "total": { "type": "integer", "minimum": 1, "maximum": 10 },
    "queued": { "type": "integer", "minimum": 0, "maximum": 10 },
    "running": { "type": "integer", "minimum": 0, "maximum": 3 },
    "completed": { "type": "integer", "minimum": 0, "maximum": 10 },
    "failed": { "type": "integer", "minimum": 0, "maximum": 10 },
    "cancelled": { "type": "integer", "minimum": 0, "maximum": 10 },
    "updated_at": { "$ref": "https://schemas.forgesec.local/v1/common.schema.json#/$defs/timestamp" }
  }
}

