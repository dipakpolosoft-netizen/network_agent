{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.forgesec.local/v1/scan-request.schema.json",
  "title": "ForgeSec Selected Device Scan Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_type", "scan_id", "discovery_id", "agent_id", "profile", "targets", "concurrency", "authorization_confirmed", "requested_at"],
  "properties": {
    "schema_version": { "$ref": "https://schemas.forgesec.local/v1/common.schema.json#/$defs/schemaVersion" },
    "message_type": { "const": "scan.request" },
    "scan_id": { "$ref": "https://schemas.forgesec.local/v1/common.schema.json#/$defs/uuid" },
    "discovery_id": { "$ref": "https://schemas.forgesec.local/v1/common.schema.json#/$defs/uuid" },
    "agent_id": { "$ref": "https://schemas.forgesec.local/v1/common.schema.json#/$defs/uuid" },
    "profile": { "enum": ["inventory", "network_services", "standard", "full_tcp"] },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/scanTarget" }
    },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 3 },
    "authorization_confirmed": { "const": true },
    "requested_at": { "$ref": "https://schemas.forgesec.local/v1/common.schema.json#/$defs/timestamp" }
  },
  "$defs": {
    "scanTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "ip"],
      "properties": {
        "device_id": { "type": "string", "minLength": 8, "maxLength": 128 },
        "ip": { "$ref": "https://schemas.forgesec.local/v1/common.schema.json#/$defs/ipv4" },
        "hostname": { "type": ["string", "null"], "maxLength": 255 },
        "vendor": { "type": ["string", "null"], "maxLength": 255 },
        "snmp_name": { "type": ["string", "null"], "maxLength": 255 },
        "snmp_description": { "type": ["string", "null"], "maxLength": 1024 },
        "snmp_object_id": { "type": ["string", "null"], "maxLength": 255 },
        "snmp_contact": { "type": ["string", "null"], "maxLength": 255 },
        "snmp_location": { "type": ["string", "null"], "maxLength": 255 },
        "snmp_uptime_seconds": { "type": ["integer", "null"], "minimum": 0 },
        "snmp_interface_count": { "type": ["integer", "null"], "minimum": 0 },
        "snmp_interfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/snmpInterface" },
          "maxItems": 256
        },
        "device_type": { "type": ["string", "null"], "maxLength": 64 },
        "classification_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "snmpInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index"],
      "properties": {
        "index": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "name": { "type": ["string", "null"], "maxLength": 255 },
        "description": { "type": ["string", "null"], "maxLength": 255 },
        "interface_type": { "type": ["string", "null"], "maxLength": 64 },
        "admin_status": { "type": ["string", "null"], "maxLength": 64 },
        "oper_status": { "type": ["string", "null"], "maxLength": 64 },
        "speed_mbps": { "type": ["number", "null"], "minimum": 0 },
        "alias": { "type": ["string", "null"], "maxLength": 255 }
      }
    }
  }
}

