{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.telesec.local/v1/scan-request.schema.json",
  "title": "Telesec Selected Device Scan Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_type", "scan_id", "discovery_id", "agent_id", "profile", "targets", "concurrency", "authorization_confirmed", "requested_at"],
  "properties": {
    "schema_version": { "$ref": "https://schemas.telesec.local/v1/common.schema.json#/$defs/schemaVersion" },
    "message_type": { "const": "scan.request" },
    "scan_id": { "$ref": "https://schemas.telesec.local/v1/common.schema.json#/$defs/uuid" },
    "discovery_id": { "$ref": "https://schemas.telesec.local/v1/common.schema.json#/$defs/uuid" },
    "agent_id": { "$ref": "https://schemas.telesec.local/v1/common.schema.json#/$defs/uuid" },
    "profile": { "enum": ["standard", "full_tcp"] },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "https://schemas.telesec.local/v1/common.schema.json#/$defs/ipv4" }
    },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 3 },
    "authorization_confirmed": { "const": true },
    "requested_at": { "$ref": "https://schemas.telesec.local/v1/common.schema.json#/$defs/timestamp" }
  }
}

