{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.forgesec.local/v1/common.schema.json",
  "title": "ForgeSec Common Types",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ipv4": {
      "type": "string",
      "format": "ipv4"
    },
    "cidr": {
      "type": "string",
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$"
    },
    "macAddress": {
      "type": ["string", "null"],
      "pattern": "^(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}

